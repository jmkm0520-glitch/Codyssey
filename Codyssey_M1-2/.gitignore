# 과제 원문은 로컬에서만 보관
subject.md

# 로컬 Python 가상환경
.venv/

# 환경 변수와 비밀정보 (.env.example은 공유)
.env
.env.*
!.env.example
firebase-service-account.json
*service-account*.json
*service_account*.json

# Python 캐시와 테스트/검사 도구 캐시
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 원본 대용량 데이터 (전처리 결과 CSV는 추적 가능)
data/*.xlsx
data/*.xls
data/raw/

# 운영체제와 편집기 임시 파일
.DS_Store
.idea/
.vscode/
