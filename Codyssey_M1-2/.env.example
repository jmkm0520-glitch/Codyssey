# 코디세이 공개 API 콘솔의 문서 탭에서 확인한 값을 입력하세요.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Firebase 서비스 계정은 JSON 문자열 또는 파일 경로 중 한 방식만 사용하세요.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# 쉼표로 구분합니다. 운영 시 실제 Vercel 주소를 추가하세요.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 프론트엔드에서 사용할 FastAPI 서버 주소입니다.
API_BASE_URL=http://localhost:8000
