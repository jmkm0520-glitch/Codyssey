# 코디세이 공개 API 콘솔의 문서 탭에서 확인한 값을 입력하세요.
# OPENAI_API_KEY에는 콘솔에서 발급한 virtual key를 넣습니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5.4-mini
# AI 답변의 최대 길이(토큰)와 응답 대기 제한 시간(초)입니다.
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_TIMEOUT_SECONDS=20

# 개발·테스트에서만 실제 OpenAI 대신 가짜 AI를 쓰고 싶을 때 true로 설정하세요.
# ENVIRONMENT=production이면 이 값은 무시되고 항상 실제 AI를 호출합니다.
USE_MOCK_AI=false
ENVIRONMENT=development

# Firebase 서비스 계정은 JSON 문자열 또는 파일 경로 중 한 방식만 사용하세요.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# 쉼표로 구분합니다. 운영 시 예시 Vercel 주소를 실제 주소로 바꾸세요.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-project.vercel.app

# 프론트엔드에서 사용할 FastAPI 서버 주소입니다.
API_BASE_URL=http://localhost:8000
